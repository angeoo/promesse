MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=promesse
S3_REGION=eu-west-3
S3_BUCKET=promesse-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for S3-compatible providers (Cloudflare R2, MinIO, etc.)
# S3_ENDPOINT=https://<your-endpoint>

# Admin auth (Auth.js credentials)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
NEXTAUTH_SECRET=change-me-too
RESEND_API_KEY=
ADMIN_FROM_EMAIL=${ADMIN_EMAIL}
ADMIN_MEDIA_WRITE_MAX_ATTEMPTS=30
ADMIN_MEDIA_WRITE_WINDOW_MS=900000
ADMIN_MEDIA_WRITE_BLOCK_MS=900000

# Public canonical URL (SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public media endpoint rate limit (/api/media/:id)
PUBLIC_MEDIA_MAX_ATTEMPTS=180
PUBLIC_MEDIA_WINDOW_MS=60000
PUBLIC_MEDIA_BLOCK_MS=300000

# Kill switch upload quotas (API /admin/media)
MEDIA_KILL_SWITCH_ENABLED=true
MEDIA_MAX_ASSETS=200
MEDIA_MAX_TOTAL_MB=4096
