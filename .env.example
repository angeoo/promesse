MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=promesse
S3_REGION=eu-west-3
S3_BUCKET=promesse-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for S3-compatible providers (Cloudflare R2, MinIO, etc.)
# S3_ENDPOINT=https://<your-endpoint>

# Admin auth (simple password form)
ADMIN_PASSWORD=change-me
# Optional, defaults to ADMIN_PASSWORD when omitted
ADMIN_AUTH_SECRET=change-me-too

# Kill switch upload quotas (API /admin/media)
MEDIA_KILL_SWITCH_ENABLED=true
MEDIA_MAX_ASSETS=200
MEDIA_MAX_TOTAL_MB=4096
